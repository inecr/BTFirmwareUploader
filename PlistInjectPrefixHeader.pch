#ifndef PlistInjectPrefixHeader_pch
#define PlistInjectPrefixHeader_pch

// Include any system framework and library headers here that should be included in all compilation units.
// You will also need to set the Prefix Header build setting of one or more of your targets to reference this file.

#define TARGET_MAC_OSX_10_11 1

#if TARGET_MAC_OSX_10_11
#define USB_PROVIDER        IOUSBHostDevice
#define USB_FAMILY          com.apple.iokit.IOUSBHostFamily
#define USB_FAMILY_VER      1.0.1
#define OSX_FAMILY_VER      11.0.0
#else
#define USB_PROVIDER        IOUSBDevice
#define USB_FAMILY          com.apple.iokit.IOUSBFamily
#define USB_FAMILY_VER      3.7.8
#define OSX_FAMILY_VER      9.0.0
#endif


#define COPYRIGHT_STRING    Copyright © EMlyDinEsH (mg-dinesh@live.com) 2012-2016. All rights reserved.

#endif /* PlistInjectPrefixHeader_pch */
